# Copy to .env next to docker-compose.prod.yml, fill it in, then `chmod 600 .env`.
# Compose reads it; only the variables below reach the containers.

# Replace OWNER with the account that built the images, lowercase. A fork
# publishes under its own login; `ultipro` serves this repository's builds.
FOLDERLY_IMAGE=ghcr.io/OWNER/folderly-backend
FOLDERLY_WEB_IMAGE=ghcr.io/OWNER/folderly-web

# `latest` follows every green build; sha-abc1234 pins one commit, both images.
IMAGE_TAG=latest

# The domain Caddy certifies. Empty = plain HTTP on :80, for trying it locally.
FOLDERLY_DOMAIN=files.example.com

# Generate it on this host; changing it logs everyone out.
#   openssl rand -hex 32
JWT_SECRET_KEY=

# Origins the browser may call the API from, normally just the domain above.
CORS_ORIGINS=https://files.example.com

# Uploads are refused with 507 past this fill level, counting the incoming file.
DISK_USAGE_LIMIT_PERCENT=85

# Gunicorn sizing. These suit a small machine; raise them on a bigger host.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
