# Copy to .env and fill in before `docker compose up`. .env is gitignored — never commit it.

# Root of the folder storage. Inside Docker this path is also the volume mount point.
DISK_PATH=/disk

# Directory for the SQLite database (folderly.db). Must exist and must not be inside
# DISK_PATH, the tree the API serves files from. Also a volume mount point.
DB_DIR=/db

# Signing key for the JWTs. Generate a fresh one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me

# How full the disk may get before uploads are refused with a 507. Optional;
# defaults to 85. The frontend shows the same figure on its storage bar.
DISK_USAGE_LIMIT_PERCENT=85

# Comma-separated list of origins the frontend is served from.
# "*" (the default) allows any origin — fine in development, tighten for deployment.
CORS_ORIGINS=*
